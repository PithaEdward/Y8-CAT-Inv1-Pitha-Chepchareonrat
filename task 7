import turtle

screen = turtle.Screen()
screen.bgcolor("white")

pen = turtle.Turtle()
pen.color("green")
pen.speed(0)
pen.left(90)

def simpletree(n):
    if n == 0:
        return

    pen.forward(50)

    pen.left(30)
    simpletree(n - 1)

    pen.right(60)
    simpletree(n - 1)

    pen.left(30)
    pen.backward(50)

simpletree(4)

turtle.done()